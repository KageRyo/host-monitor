# Host Monitor environment configuration
# Copy this file to .env. Process environment variables take precedence.

# HTTP listening port
PORT=3000

# Automatic check interval in milliseconds
CHECK_INTERVAL=30000

# Rotate logs at 5 MiB and retain up to five backups (monitor.log.1–5)
LOG_MAX_BYTES=5242880
LOG_MAX_FILES=5

# Disable console output to avoid duplicate logs under process managers
LOG_TO_STDOUT=false
