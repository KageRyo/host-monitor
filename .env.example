# Host Monitor environment configuration
# Copy this file to .env. Process environment variables take precedence.

# HTTP listening port: 1–65535; invalid values fall back to 3000
PORT=3000

# IPv4 bind address; keeps existing LAN access by default. Invalid values stop startup.
# Use 127.0.0.1 behind a local authenticated reverse proxy.
HOST=0.0.0.0

# Optional HTTP Basic authentication for the dashboard and ALL API endpoints.
# Set both credentials before enabling; missing/invalid credentials stop startup.
# Remote access must use HTTPS through a reverse proxy. Do not commit your .env.
AUTH_ENABLED=false
AUTH_USERNAME=
AUTH_PASSWORD=

# Automatic check interval: 1000–2147483647 milliseconds; invalid values fall back to 30000
CHECK_INTERVAL=30000

# Rotate logs at 5 MiB and retain up to five backups (monitor.log.1–5)
LOG_MAX_BYTES=5242880
LOG_MAX_FILES=5

# Disable console output to avoid duplicate logs under process managers
LOG_TO_STDOUT=false

# Shared probe queue and process-wide manual check quota (per 60 seconds)
PROBE_CONCURRENCY=5
MAX_MONITORS=100
MANUAL_CHECK_LIMIT=10

# Optional generic JSON webhook; never used by the browser demo
WEBHOOK_ENABLED=false
# Alert once when the first successfully persisted check is down (one-check threshold)
WEBHOOK_INITIAL_DOWN=false
WEBHOOK_URL=
WEBHOOK_TIMEOUT_MS=5000
