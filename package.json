{
  "name": "host-monitor",
  "version": "0.1.1",
  "description": "A self-hosted Go service for monitoring hosts, NAS devices and printers.",
  "scripts": {
    "start": "go run .",
    "test": "node --test",
    "build:css": "tailwindcss -c tailwind.config.js -i src/input.css -o public/styles.css --minify",
    "build:demo": "npm run build:css && node scripts/build-demo.js",
    "test:browser": "npm run build:demo && node scripts/verify-demo-browser.cjs",
    "browser:install": "playwright install chromium",
    "start:legacy": "node server.js",
    "test:go-contract": "python3 scripts/test-go-contract.py"
  },
  "keywords": [
    "uptime",
    "monitoring",
    "ping",
    "self-hosted",
    "server-monitor",
    "nas"
  ],
  "author": "Chien-Hsun Chang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/KageRyo/host-monitor.git"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "tailwindcss": "^3.4.17",
    "express": "^5.2.1",
    "ping": "^0.4.4"
  },
  "overrides": {
    "postcss-selector-parser": "^7.1.7"
  }
}
