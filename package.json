{
  "name": "host-monitor",
  "version": "0.2.0",
  "description": "A lightweight, self-hosted server/NAS/device uptime monitoring tool with a clean UI. Similar to Uptime Kuma but simpler.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "build:css": "tailwindcss -c tailwind.config.js -i src/input.css -o public/styles.css --minify",
    "build:demo": "npm run build:css && node scripts/build-demo.js",
    "test:browser": "npm run build:demo && node scripts/verify-demo-browser.cjs",
    "browser:install": "playwright install chromium"
  },
  "keywords": [
    "uptime",
    "monitoring",
    "ping",
    "self-hosted",
    "server-monitor",
    "nas"
  ],
  "author": "Chien-Hsun Chang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/KageRyo/host-monitor.git"
  },
  "dependencies": {
    "express": "^5.2.1",
    "ping": "^0.4.4"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "tailwindcss": "^3.4.17"
  }
}
